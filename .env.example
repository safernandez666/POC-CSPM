# ============================================
# AWS Credentials
# ============================================
# Copia este archivo a .env y completa con tus credenciales

AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_SESSION_TOKEN=your_session_token_here_if_using_sso
AWS_DEFAULT_REGION=us-east-1

# ============================================
# Slack (opcional)
# ============================================
# Incoming webhook para que Cloud Custodian notifique remediaciones.
# Si lo dejás vacío, las policies simplemente no notifican a Slack.
SLACK_WEBHOOK_URL=

# ============================================
# Notas:
# ============================================
# 1. El archivo .env está en .gitignore (no se subirá a GitHub)
# 2. Si usas AWS SSO/IAM Identity Center, necesitas AWS_SESSION_TOKEN
# 3. Si usas access keys permanentes, omite AWS_SESSION_TOKEN
# 4. Puedes cambiar la región pero us-east-1 tiene más servicios

# ============================================
# Obtener credenciales:
# ============================================
# Opción 1: AWS SSO
#   aws sso login --profile tu-perfil
#   aws configure export-credentials --profile tu-perfil
#
# Opción 2: Access Keys (IAM User)
#   AWS Console → IAM → Users → Security credentials → Create access key
#
# Opción 3: Variables de entorno directas
#   export AWS_ACCESS_KEY_ID=xxx
#   export AWS_SECRET_ACCESS_KEY=xxx
